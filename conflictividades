    <!-- Map Library -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    
    <script>
        // --- COORDENADAS BASE (Aproximadas para visualización en La Guajira) ---
        const coordenadas = {
            "uribia": { lat: 11.733, lng: -72.266 },
            "maicao": { lat: 11.378, lng: -72.243 },
            "albania": { lat: 11.161, lng: -72.589 },
            "riohacha": { lat: 11.544, lng: -72.907 },
            "dibulla": { lat: 11.272, lng: -73.308 },
            "villanueva": { lat: 10.603, lng: -72.980 },
            "fonseca": { lat: 10.893, lng: -72.852 },
            "san juan del cesar": {lat: 10.768, lng: -73.003},
            "barrancas": {lat: 10.957, lng: -72.784},
            "manaure": {lat: 11.775, lng: -72.445}
        };

        // --- ENLACES CSV (Forzando la descarga en formato CSV mediante API gviz) ---
        const urls = {
            resumen: "https://docs.google.com/spreadsheets/d/1O_NhRMpZZFkwIWZU0Yd1ttY_ZhS1EKHAnY23JPv79BM/gviz/tq?tqx=out:csv",
            municipios: "https://docs.google.com/spreadsheets/d/1wy432HcQDG7-ALc-WFXYbEEh_SrZg8X0A3KU_15i9OY/gviz/tq?tqx=out:csv",
            tipologias: "https://docs.google.com/spreadsheets/d/1RKpRCVwdQEs82MvZy14gK0SXXQOF5kwCHFIhFcwh4Fk/gviz/tq?tqx=out:csv",
            empresas: "https://docs.google.com/spreadsheets/d/1hLVvAoAUnbNJZqdKEJNPXpiPS64kO7HZEGaiopBhdO4/gviz/tq?tqx=out:csv",
            proyectos: "https://docs.google.com/spreadsheets/d/1ZfoR9D_ptVfTIJVOJc-aoQI9WxgLa4YecnhaOc3GAys/gviz/tq?tqx=out:csv"
        };

        // --- BASES DE DATOS EN MEMORIA ---
        let dbResumen = [];
        let dbMunicipios = [];
        let dbTipologias = [];
        let dbEmpresas = []; 
        let dbProyectos = []; 
        
        let mapConf;
        let marcadoresConflictos = [];
        let graficoEmpresasInstance = null;
        let añosDisponibles = ["Todos"];

        // Normalizador de texto estricto (quita tildes, minúsculas, espacios extra)
        const normalizar = (texto) => {
            if(!texto) return "";
            return texto.toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
        };

        // Buscador de columnas
        const findColumn = (row, palabrasClave) => {
            return Object.keys(row).find(key => {
                const keyNorm = normalizar(key);
                return palabrasClave.some(palabra => keyNorm.includes(palabra));
            });
        };

        // --- CARGA Y PROCESAMIENTO DE DATOS ---
        async function cargarDatosGoogleSheets() {
            const syncUI = document.getElementById('sync-status');
            
            try {
                const fetchCSV = (url) => new Promise((resolve, reject) => {
                    Papa.parse(url, { download: true, header: true, skipEmptyLines: true, 
                        complete: res => resolve(res.data), error: err => reject(err)
                    });
                });

                const [dataResumen, dataMuni, dataTipo, dataEmp, dataProy] = await Promise.all([
                    fetchCSV(urls.resumen), fetchCSV(urls.municipios), fetchCSV(urls.tipologias),
                    fetchCSV(urls.empresas), fetchCSV(urls.proyectos)
                ]);

                // 1. Resumen Anual
                dbResumen = dataResumen.map(row => {
                    let yearCol = findColumn(row, ['ano']);
                    let casosCol = findColumn(row, ['caso', 'priorizado', 'conflicto']);
                    let comunCol = findColumn(row, ['comunidad', 'impacta']);
                    return {
                        año: row[yearCol] ? row[yearCol].toString().trim() : '',
                        casos: row[casosCol] ? parseInt(row[casosCol]) || 0 : 0,
                        comunidades: row[comunCol] ? parseInt(row[comunCol]) || 0 : 0
                    };
                }).filter(item => item.año && item.casos > 0);

                let añosEncontrados = [...new Set(dbResumen.map(d => d.año))].sort();
                añosDisponibles = ["Todos", ...añosEncontrados];

                // 2. Municipios
                dbMunicipios = dataMuni.map(row => {
                    let yearCol = findColumn(row, ['ano']);
                    let muniCol = findColumn(row, ['municipio', 'lugar']);
                    let confCol = findColumn(row, ['conflicto', 'cantidad', 'numero']);
                    
                    let nombreMuni = row[muniCol] ? row[muniCol].toString().trim() : 'Desconocido';
                    let coord = coordenadas[normalizar(nombreMuni)] || { lat: 11.544, lng: -72.907 }; 

                    return {
                        año: row[yearCol] ? row[yearCol].toString().trim() : '',
                        municipio: nombreMuni,
                        conflictos: row[confCol] ? parseInt(row[confCol]) || 0 : 0,
                        lat: coord.lat, lng: coord.lng
                    };
                }).filter(item => item.año && item.conflictos > 0);

                // 3. Tipologías
                dbTipologias = dataTipo.map(row => {
                    let yearCol = findColumn(row, ['ano']);
                    let tipoCol = findColumn(row, ['tipolog', 'tipo']);
                    let confCol = findColumn(row, ['conflicto', 'cantidad']);
                    return {
                        año: row[yearCol] ? row[yearCol].toString().trim() : '',
                        tipo: row[tipoCol] ? row[tipoCol].toString().trim() : 'Otros',
                        conflictos: row[confCol] ? parseInt(row[confCol]) || 0 : 0
                    };
                }).filter(item => item.año && item.conflictos > 0);

                // 4. Empresas
                dbEmpresas = dataEmp.map(row => {
                    let yearCol = findColumn(row, ['ano']);
                    // Cuidar que no se confunda con "Empresa Ejecutora" si por error lo pusieron aquí
                    let empCol = Object.keys(row).find(key => normalizar(key) === 'empresa' || normalizar(key) === 'compania');
                    let confCol = findColumn(row, ['conflicto', 'cantidad']);
                    
                    if(!empCol) empCol = findColumn(row, ['empresa']); // Fallback

                    return {
                        año: row[yearCol] ? row[yearCol].toString().trim() : '',
                        empresa: row[empCol] ? row[empCol].toString().trim() : 'N/A',
                        conflictos: row[confCol] ? parseInt(row[confCol]) || 0 : 0
                    };
                }).filter(item => item.año && item.conflictos > 0);

                // 5. Proyectos (Con distinción entre Empresa y Empresa Ejecutora)
                dbProyectos = dataProy.map(row => {
                    let yearCol = findColumn(row, ['ano']);
                    
                    // Lógica estricta para diferenciar "Empresa" de "Empresa ejecutora"
                    let empEjecCol = Object.keys(row).find(key => normalizar(key).includes('ejecutora') || normalizar(key).includes('ejecutor') || normalizar(key).includes('contratista'));
                    let empCol = Object.keys(row).find(key => normalizar(key) === 'empresa' || (normalizar(key).includes('empresa') && !normalizar(key).includes('ejecutor')));
                    
                    let proyCol = findColumn(row, ['proyecto', 'bloque', 'contrato', 'nombre', 'detalle']);
                    let confCol = findColumn(row, ['conflicto', 'cantidad', 'casos', 'total', 'numero']);
                    
                    return {
                        año: row[yearCol] ? row[yearCol].toString().trim() : '',
                        empresa: empCol && row[empCol] ? row[empCol].toString().trim() : 'No Especificada',
                        empresa_ejecutora: empEjecCol && row[empEjecCol] ? row[empEjecCol].toString().trim() : 'N/A',
                        proyecto: proyCol && row[proyCol] ? row[proyCol].toString().trim() : 'N/A',
                        conflictos: confCol && row[confCol] ? parseInt(row[confCol]) || 0 : 0
                    };
                }).filter(item => item.año);

                syncUI.style.display = 'none';
                renderTimeline();
                generarBotonesFiltro();
                aplicarFiltro('Todos'); 

            } catch (error) {
                console.error("Error al sincronizar CSVs:", error);
                syncUI.className = 'mb-4 text-sm text-red-600 bg-red-50 p-3 rounded flex items-center border border-red-200 shadow-sm';
                syncUI.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-red-500 mr-2 text-lg"></i> <span class="font-semibold">Error al conectar con Google Sheets. Verifica los permisos de los enlaces.</span>`;
            }
        }

        // --- LÓGICA DE INTERFAZ Y MAPAS ---
        function initMap() {
            mapConf = L.map('map-conflictos').setView([11.5444, -72.9072], 8);
            // Usando CartoDB Light para evitar bloqueos de CORS
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap &copy; CARTO',
                maxZoom: 19
            }).addTo(mapConf);
        }

        function renderTimeline() {
            const container = document.getElementById('timeline-content');
            container.innerHTML = '';
            
            if(dbResumen.length === 0) {
                container.innerHTML = '<p class="text-sm text-gray-500 italic p-4">No hay datos históricos disponibles.</p>';
                return;
            }

            dbResumen.forEach(item => {
                container.innerHTML += `
                    <div class="timeline-item text-center">
                        <div class="pt-6">
                            <div class="timeline-dot shadow-md ring-4 ring-white"></div>
                        </div>
                        <div class="mt-4 mx-2">
                            <h4 class="text-3xl font-black text-guajira-sea drop-shadow-sm">${item.año}</h4>
                            <div class="mt-3 flex justify-center space-x-3 bg-white/60 backdrop-blur-sm rounded-full py-2 px-3 shadow-sm border border-gray-100">
                                <div class="text-center">
                                    <span class="font-black text-red-500 text-lg">${item.casos}</span>
                                    <span class="text-[9px] text-gray-500 uppercase font-bold block leading-none">Casos</span>
                                </div>
                                <div class="border-l border-gray-300"></div>
                                <div class="text-center">
                                    <span class="font-black text-gray-700 text-lg">${item.comunidades}</span>
                                    <span class="text-[9px] text-gray-500 uppercase font-bold block leading-none">Comun.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function generarBotonesFiltro() {
            const container = document.getElementById('botones-filtro-container');
            container.innerHTML = '';
            añosDisponibles.forEach(año => {
                const isActive = año === 'Todos' ? 'bg-guajira-sea text-white border-transparent' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50';
                container.innerHTML += `<button class="filtro-btn px-5 py-2 text-sm font-semibold border shadow-sm rounded-lg transition-all whitespace-nowrap ${isActive}" data-year="${año}" onclick="aplicarFiltro('${año}')">${año}</button>`;
            });
        }

        function aplicarFiltro(year) {
            // Estilos de botones
            document.querySelectorAll('.filtro-btn').forEach(btn => {
                if(btn.getAttribute('data-year') === year) {
                    btn.classList.add('bg-guajira-sea', 'text-white', 'border-transparent');
                    btn.classList.remove('bg-white', 'text-gray-600', 'border-gray-200', 'hover:bg-gray-50');
                } else {
                    btn.classList.remove('bg-guajira-sea', 'text-white', 'border-transparent');
                    btn.classList.add('bg-white', 'text-gray-600', 'border-gray-200', 'hover:bg-gray-50');
                }
            });

            const tituloText = year === 'Todos' ? 'Todos los años' : year;
            document.getElementById('mapa-titulo-ano').innerText = tituloText;
            document.getElementById('tipologia-titulo-ano').innerText = `(${tituloText})`;
            document.getElementById('empresas-titulo-ano').innerText = `(${tituloText})`;

            let datosFiltradosMap = year === 'Todos' ? dbMunicipios : dbMunicipios.filter(d => d.año === year);

            renderMapa(datosFiltradosMap);
            renderTipologias(year);
            renderEmpresasYProyectos(year);
        }

        function renderMapa(datosFiltrados) {
            if(!mapConf) return;
            marcadoresConflictos.forEach(m => mapConf.removeLayer(m));
            marcadoresConflictos = [];

            const agrupados = {};
            datosFiltrados.forEach(d => {
                if(!agrupados[d.municipio]) agrupados[d.municipio] = { lat: d.lat, lng: d.lng, total: 0 };
                agrupados[d.municipio].total += d.conflictos;
            });

            Object.keys(agrupados).forEach(muni => {
                const data = agrupados[muni];
                if(data.total === 0) return;

                const size = Math.min(Math.max(35, 25 + (data.total * 1.5)), 80); 

                const customMarker = L.divIcon({
                    html: `<div class="bg-red-500 text-white rounded-full flex items-center justify-center font-bold shadow-lg border-2 border-white transform transition-transform hover:scale-110" style="width: ${size}px; height: ${size}px; opacity: 0.95;">${data.total}</div>`,
                    className: '', iconSize: [size, size], iconAnchor: [size/2, size/2]
                });

                const marker = L.marker([data.lat, data.lng], {icon: customMarker})
                    .bindPopup(`<div class="text-center p-1"><b class="text-lg text-gray-800 uppercase">${muni}</b><br><span class="text-red-600 font-black text-2xl leading-none">${data.total}</span><br><span class="text-[10px] text-gray-500 uppercase font-bold tracking-wider">Conflictos Registrados</span></div>`)
                    .addTo(mapConf);
                marcadoresConflictos.push(marker);
            });
        }

        function renderTipologias(year) {
            const container = document.getElementById('tipologia-content');
            container.innerHTML = '';

            let datosFiltrados = year === 'Todos' ? dbTipologias : dbTipologias.filter(d => d.año === year);

            let totalConflictos = 0;
            const agrupados = {};
            
            datosFiltrados.forEach(d => {
                agrupados[d.tipo] = (agrupados[d.tipo] || 0) + d.conflictos;
                totalConflictos += d.conflictos;
            });

            const arrayOrdenado = Object.keys(agrupados).map(tipo => {
                let count = agrupados[tipo];
                let porcentaje = totalConflictos > 0 ? ((count / totalConflictos) * 100).toFixed(1) : 0;
                return { tipo, count, porcentaje };
            }).sort((a, b) => b.count - a.count);

            if(arrayOrdenado.length === 0) {
                container.innerHTML = '<p class="text-sm text-gray-500 italic p-4 text-center">No hay tipologías para este año.</p>';
                return;
            }

            const colors = ['bg-red-500', 'bg-guajira-sun', 'bg-guajira-sea', 'bg-gray-600', 'bg-indigo-500', 'bg-teal-500'];
            arrayOrdenado.forEach((item, index) => {
                const color = colors[index % colors.length];
                container.innerHTML += `
                    <div class="mb-3">
                        <div class="flex justify-between text-sm mb-1 items-end">
                            <span class="font-semibold text-gray-700 truncate pr-2">${item.tipo}</span>
                            <span class="font-bold text-gray-900 whitespace-nowrap">${item.count} <span class="text-gray-400 font-normal text-xs ml-1 bg-gray-100 px-1.5 rounded">(${item.porcentaje}%)</span></span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-2">
                            <div class="${color} h-2 rounded-full" style="width: ${item.porcentaje}%"></div>
                        </div>
                    </div>
                `;
            });
        }

        function renderEmpresasYProyectos(year) {
            // --- 1. PROCESAMIENTO GRÁFICO EMPRESAS (Hoja 4) ---
            let empFiltrados = year === 'Todos' ? dbEmpresas : dbEmpresas.filter(d => d.año === year);
            const agrupadoEmpresa = {};
            
            empFiltrados.forEach(d => {
                agrupadoEmpresa[d.empresa] = (agrupadoEmpresa[d.empresa] || 0) + d.conflictos;
            });

            // Arreglo con TODAS las empresas ordenadas de mayor a menor
            const empresasOrdenadas = Object.keys(agrupadoEmpresa)
                .sort((a,b) => agrupadoEmpresa[b] - agrupadoEmpresa[a]);
            
            // Ajustar altura del contenedor dinámicamente (mínimo 250px, si hay muchas suma altura)
            const chartContainer = document.getElementById('chart-container');
            const baseHeightPerBar = 35; 
            chartContainer.style.height = Math.max(250, empresasOrdenadas.length * baseHeightPerBar) + 'px';

            if(graficoEmpresasInstance) graficoEmpresasInstance.destroy();
            const ctx = document.getElementById('empresasChart').getContext('2d');
            
            if(empresasOrdenadas.length > 0) {
                graficoEmpresasInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: empresasOrdenadas,
                        datasets: [{ 
                            label: 'Conflictos', 
                            data: empresasOrdenadas.map(emp => agrupadoEmpresa[emp]), 
                            backgroundColor: '#0077b6', // Azul guajira
                            borderRadius: 4, 
                            barThickness: 15
                        }]
                    },
                    options: {
                        indexAxis: 'y', // Gráfico Horizontal (Barra Invertida)
                        responsive: true, 
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            // --- 2. PROCESAMIENTO TABLA PROYECTOS (Hoja 5) ---
            const tbody = document.getElementById('tabla-proyectos-content');
            tbody.innerHTML = '';
            
            let proyFiltrados = year === 'Todos' ? dbProyectos : dbProyectos.filter(d => d.año === year);

            if(proyFiltrados.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-gray-500 italic">No hay proyectos para este filtro.</td></tr>';
            } else {
                // Ordenar la tabla basándose en el ranking del gráfico de empresas
                proyFiltrados.sort((a, b) => {
                    let rankA = empresasOrdenadas.indexOf(a.empresa);
                    let rankB = empresasOrdenadas.indexOf(b.empresa);
                    
                    // Si no está en el gráfico, mandarlo al final
                    if(rankA === -1) rankA = 9999;
                    if(rankB === -1) rankB = 9999;
                    
                    if(rankA !== rankB) return rankA - rankB; // Ordena por posición de la empresa
                    return b.conflictos - a.conflictos;       // Sub-ordena por conflictos
                }).forEach(d => {
                    tbody.innerHTML += `
                        <tr class="bg-white border-b hover:bg-blue-50 transition-colors">
                            <td class="px-4 py-3 font-bold text-gray-800 text-[11px] uppercase">${d.empresa}</td>
                            <td class="px-4 py-3 text-gray-600 text-xs">${d.empresa_ejecutora}</td>
                            <td class="px-4 py-3 text-gray-700 text-sm">${d.proyecto}</td>
                        </tr>
                    `;
                });
            }

            // --- 3. ACTUALIZAR POST-IT DE RESUMEN ---
            // Se calculan las empresas y proyectos únicos excluyendo valores vacíos o 'N/A'
            const empresasUnicas = new Set(proyFiltrados.map(d => normalizar(d.empresa)).filter(e => e && e !== 'na' && e !== 'no especificada')).size;
            const proyectosUnicos = new Set(proyFiltrados.map(d => normalizar(d.proyecto)).filter(p => p && p !== 'na')).size;
            
            document.getElementById('resumen-empresas-text').innerHTML = `Se identificaron <b>${empresasUnicas}</b> empresas participando en <b>${proyectosUnicos}</b> proyectos únicos durante este periodo.`;
        }

        function openTab(evt, tabName) {
            document.querySelectorAll(".tab-content").forEach(el => {
                el.style.display = "none";
                el.classList.remove("active");
            });
            document.querySelectorAll(".tab-btn").forEach(btn => btn.classList.remove("active"));
            
            document.getElementById(tabName).style.display = "block";
            setTimeout(() => document.getElementById(tabName).classList.add("active"), 10);
            evt.currentTarget.classList.add("active");

            if(tabName === 'conflictividades' && mapConf) mapConf.invalidateSize();
        }

        window.onload = () => {
            initMap();
            cargarDatosGoogleSheets(); 
        };
    </script>
</body>
